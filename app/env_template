# Station number. Becomes the device name (device54), the RDS table name, and
# the ack topic. Digits only for a production station.
# Example: DEVICE_ID=54
DEVICE_ID=

# Topic the station publishes measurements to. Must match the topic in the AWS
# IoT rule that triggers the data_to_rds Lambda.
# Example: MQTT_TOPIC=example/devices
MQTT_TOPIC=

# AWS IoT Core device data endpoint. Found in the AWS IoT console under Settings.
# Example: MQTT_BROKER_ENDPOINT=xxxxxxxxxxxxxxxxx.iot.us-xxxx-x.amazonaws.com
MQTT_BROKER_ENDPOINT=

# Topic the Lambda confirms stored records on. Required: with this unset the
# station never learns what was stored and keeps every record buffered forever.
# Must be the same string ACK_TOPIC_TEMPLATE in the Lambda's config produces for
# this device, and unique per station.
# Example: MQTT_ACK_TOPIC=example-ack/device1
MQTT_ACK_TOPIC=

# Station coordinates in decimal degrees, used for the Open-Meteo UV lookup.
# Leave blank and UV is reported as null - better than another place's reading.
# Example: LATITUDE=12.3456
# Example: LONGITUDE=-65.4321
LATITUDE=
LONGITUDE=

# Local buffer holding records until the Lambda confirms them. Blank means
# local_data.json. Custom names must include the .json extension.
# Example: LOCAL_DB=local_data.json
LOCAL_DB=

# Optional: a PostgreSQL table that gets the BME280 and SHT45 readings side by
# side, one row per transmission, for comparing the two sensors. Leave
# COMPARE_DB_HOST blank to turn it off. The MQTT payload is the same either way.
# The database must accept connections from the station (security group / firewall).
# Example: COMPARE_DB_HOST=example.xxxxxxxxxxxx.eu-central-1.rds.amazonaws.com
# Example: COMPARE_DB_PORT=5432
# Example: COMPARE_DB_NAME=postgres
# Example: COMPARE_DB_TABLE=sensor_comparison
COMPARE_DB_HOST=
COMPARE_DB_PORT=
COMPARE_DB_NAME=
COMPARE_DB_USER=
COMPARE_DB_PASSWORD=
COMPARE_DB_TABLE=
